generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrar_user_id String?        @db.Uuid
  email             String         @unique @db.VarChar(320)
  passwordHash      String?        @map("password_hash") @db.VarChar(255)
  firstName         String?        @map("first_name") @db.VarChar(80)
  lastName          String?        @map("last_name") @db.VarChar(80)
  status            String         @default("ACTIVE") @db.VarChar(20)
  isPlatformAdmin   Boolean        @default(false) @map("is_platform_admin")
  tokenVersion      Int            @default(0) @map("token_version")
  lastLoginAt       DateTime?      @map("last_login_at") @db.Timestamptz(6)
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  refreshTokens     RefreshToken[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "idx_users_created_at_id")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.Inet
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_expires")
  @@map("refresh_tokens")
}

model Workspace {
  id          String       @id @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String       @db.VarChar(200)
  slug        String       @db.VarChar(100)
  description String?
  status      String       @default("active") @db.VarChar(30)
  isDefault   Boolean      @default(false) @map("is_default")
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  connections Connection[]
  folders     Folder[]
  variables   Variable[]
  workflows   Workflow[]

  @@unique([userId, slug])
  @@index([userId], map: "idx_workspaces_user")
  @@map("workspaces")
}

model Folder {
  id          String       @id @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String       @db.VarChar(200)
  slug        String       @db.VarChar(200)
  description String?
  position    Int          @default(0)
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  connections Connection[]
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variables   Variable[]
  workflows   Workflow[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@index([workspaceId], map: "idx_folders_workspace")
  @@map("folders")
}

model Workflow {
  id               String               @id @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  folderId         String?              @map("folder_id") @db.Uuid
  name             String               @db.VarChar(250)
  slug             String               @db.VarChar(150)
  description      String?
  status           String               @default("draft") @db.VarChar(30)
  active           Boolean              @default(false)
  currentVersionId String?              @map("current_version_id") @db.Uuid
  createdBy        String?              @map("created_by") @db.Uuid
  settings         Json                 @default("{}")
  metadata         Json                 @default("{}")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  queuedRuns       ExecutionQueueItem[]
  schedules        Schedule[]
  webhooks         Webhook[]
  executions       WorkflowExecution[]
  triggers         WorkflowTrigger[]
  versions         WorkflowVersion[]    @relation("WorkflowVersions")
  folder           Folder?              @relation(fields: [folderId], references: [id], onUpdate: NoAction)
  version          WorkflowVersion?     @relation("workflows_current_version_idToworkflow_versions", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "workflows_workflow_versions_id_fk")
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, folderId, name], map: "workflows_pk")
  @@index([folderId], map: "idx_workflows_folder")
  @@index([workspaceId], map: "idx_workflows_workspace")
  @@map("workflows")
}

model WorkflowVersion {
  id                                                        String               @id @db.Uuid
  workflowId                                                String               @map("workflow_id") @db.Uuid
  version                                                   Int
  status                                                    String               @default("draft") @db.VarChar(30)
  workflowJson                                              Json                 @default("{}") @map("workflow_json")
  changeSummary                                             String?              @map("change_summary")
  createdBy                                                 String?              @map("created_by") @db.Uuid
  publishedAt                                               DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt                                                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  queuedRuns                                                ExecutionQueueItem[]
  edges                                                     WorkflowEdge[]
  nodes                                                     WorkflowNode[]
  workflow                                                  Workflow             @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflows_workflows_current_version_idToworkflow_versions Workflow[]           @relation("workflows_current_version_idToworkflow_versions")

  @@unique([workflowId, version])
  @@index([workflowId], map: "idx_versions_workflow")
  @@map("workflow_versions")
}

model WorkflowNode {
  id                String                   @id @db.Uuid
  workflowVersionId String                   @map("workflow_version_id") @db.Uuid
  nodeKey           String                   @map("node_key") @db.VarChar(100)
  type              String                   @db.VarChar(100)
  name              String                   @db.VarChar(200)
  description       String?
  positionX         Int                      @default(0) @map("position_x")
  positionY         Int                      @default(0) @map("position_y")
  width             Int?
  height            Int?
  enabled           Boolean                  @default(true)
  config            Json                     @default("{}")
  metadata          Json                     @default("{}")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  executionSteps    ExecutionStep[]
  outgoingEdges     WorkflowEdge[]           @relation("EdgeSource")
  incomingEdges     WorkflowEdge[]           @relation("EdgeTarget")
  connections       WorkflowNodeConnection[]
  settings          WorkflowNodeSettings?
  workflowVersion   WorkflowVersion          @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workflowVersionId, nodeKey])
  @@index([type], map: "idx_nodes_type")
  @@index([workflowVersionId], map: "idx_nodes_version")
  @@index([type], map: "idx_workflow_nodes_type")
  @@index([workflowVersionId], map: "idx_workflow_nodes_version")
  @@map("workflow_nodes")
}

model WorkflowNodeSettings {
  id                 String       @id @db.Uuid
  nodeId             String       @unique @map("node_id") @db.Uuid
  timeoutMs          Int?         @map("timeout_ms")
  retryEnabled       Boolean      @default(false) @map("retry_enabled")
  retryCount         Int          @default(0) @map("retry_count")
  retryDelayMs       Int          @default(1000) @map("retry_delay_ms")
  retryStrategy      String       @default("fixed") @map("retry_strategy") @db.VarChar(50)
  continueOnError    Boolean      @default(false) @map("continue_on_error")
  alwaysExecute      Boolean      @default(false) @map("always_execute")
  executionCondition String?      @map("execution_condition")
  concurrencyLimit   Int?         @map("concurrency_limit")
  cacheEnabled       Boolean      @default(false) @map("cache_enabled")
  cacheTtlSeconds    Int?         @map("cache_ttl_seconds")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  node               WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("workflow_node_settings")
}

model WorkflowEdge {
  id                String          @id @db.Uuid
  workflowVersionId String          @map("workflow_version_id") @db.Uuid
  sourceNodeId      String          @map("source_node_id") @db.Uuid
  targetNodeId      String          @map("target_node_id") @db.Uuid
  sourcePort        String          @default("output") @map("source_port") @db.VarChar(100)
  targetPort        String          @default("input") @map("target_port") @db.VarChar(100)
  edgeType          String          @default("success") @map("edge_type") @db.VarChar(50)
  label             String?         @db.VarChar(200)
  config            Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  sourceNode        WorkflowNode    @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetNode        WorkflowNode    @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sourceNodeId], map: "idx_edges_source")
  @@index([targetNodeId], map: "idx_edges_target")
  @@index([workflowVersionId], map: "idx_edges_version")
  @@map("workflow_edges")
}

model WorkflowTrigger {
  id         String     @id @db.Uuid
  workflowId String     @map("workflow_id") @db.Uuid
  type       String     @db.VarChar(50)
  config     Json
  enabled    Boolean    @default(true)
  schedules  Schedule[]
  webhooks   Webhook[]
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflowId], map: "idx_triggers_workflow")
  @@map("workflow_triggers")
}

model Variable {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  folderId    String    @map("folder_id") @db.Uuid
  name        String    @db.VarChar(200)
  value       String
  encrypted   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  folders     Folder    @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "variables_folders_id_fk")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspaceId, folderId, name], map: "variables_workspace_id_folde_id_name_key")
  @@index([workspaceId], map: "idx_variables_workspace")
  @@map("variables")
}

model Connection {
  id          String                   @id @db.Uuid
  workspaceId String                   @map("workspace_id") @db.Uuid
  folderId    String                   @map("folder_id") @db.Uuid
  name        String                   @db.VarChar(200)
  type        String                   @db.VarChar(100)
  provider    String                   @db.VarChar(100)
  credentials Json                     @default("{}")
  encrypted   Boolean                  @default(true)
  status      String                   @default("active") @db.VarChar(30)
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  folders     Folder                   @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "connections_folders_id_fk")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nodeUsages  WorkflowNodeConnection[]

  @@unique([workspaceId, folderId, name], map: "connections_pk")
  @@index([workspaceId], map: "idx_connections_workspace")
  @@map("connections")
}

model WorkflowNodeConnection {
  nodeId       String       @map("node_id") @db.Uuid
  connectionId String       @map("connection_id") @db.Uuid
  purpose      String?      @default("default") @db.VarChar(100)
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node         WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([nodeId, connectionId])
  @@map("workflow_node_connections")
}

model ConnectionType {
  id        String   @id @db.Uuid
  type      String   @unique @db.VarChar(100)
  provider  String   @db.VarChar(100)
  schema    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String   @db.VarChar(200)

  @@map("connection_types")
}

model Webhook {
  id                   String          @id @db.Uuid
  workflowId           String          @map("workflow_id") @db.Uuid
  triggerId            String          @map("trigger_id") @db.Uuid
  name                 String          @db.VarChar(200)
  path                 String          @unique @db.VarChar(255)
  method               String          @default("POST") @db.VarChar(10)
  authenticationType   String          @default("none") @map("authentication_type") @db.VarChar(50)
  authenticationConfig Json            @default("{}") @map("authentication_config")
  responseMode         String          @default("immediate") @map("response_mode") @db.VarChar(50)
  responseConfig       Json            @default("{}") @map("response_config")
  enabled              Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trigger              WorkflowTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow             Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflowId], map: "idx_webhooks_workflow")
  @@map("webhooks")
}

model Schedule {
  id             String          @id @db.Uuid
  workflowId     String          @map("workflow_id") @db.Uuid
  triggerId      String          @map("trigger_id") @db.Uuid
  name           String          @db.VarChar(200)
  type           String          @default("cron") @db.VarChar(50)
  cronExpression String?         @map("cron_expression") @db.VarChar(100)
  misfirePolicy  String?         @default("execute_once") @map("misfire_policy") @db.VarChar(30)
  intervalValue  Int?            @map("interval_value")
  intervalUnit   String?         @map("interval_unit") @db.VarChar(20)
  timezone       String          @default("UTC") @db.VarChar(100)
  enabled        Boolean         @default(true)
  nextRunAt      DateTime?       @map("next_run_at") @db.Timestamptz(6)
  lastRunAt      DateTime?       @map("last_run_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trigger        WorkflowTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflowId], map: "idx_schedules_workflow")
  @@map("schedules")
}

model ExecutionQueueItem {
  id                String          @id @db.Uuid
  workflowId        String          @map("workflow_id") @db.Uuid
  workflowVersionId String          @map("workflow_version_id") @db.Uuid
  triggerType       String          @map("trigger_type") @db.VarChar(50)
  triggerId         String?         @map("trigger_id") @db.Uuid
  payload           Json            @default("{}")
  priority          Int             @default(0)
  status            String          @default("pending") @db.VarChar(30)
  attempts          Int             @default(0)
  maxAttempts       Int             @default(3) @map("max_attempts")
  availableAt       DateTime        @default(now()) @map("available_at") @db.Timestamptz(6)
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  lockedBy          String?         @map("locked_by") @db.VarChar(100)
  lockedUntil       DateTime?       @map("locked_until") @db.Timestamptz(6)
  errorMessage      String?         @map("error_message")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workflow          Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([availableAt], map: "idx_queue_available")
  @@index([status], map: "idx_queue_status")
  @@map("execution_queue")
}

model WorkflowExecution {
  id           String          @id @db.Uuid
  workflowId   String          @map("workflow_id") @db.Uuid
  version      Int
  status       String          @db.VarChar(30)
  startedAt    DateTime        @map("started_at") @db.Timestamp(6)
  finishedAt   DateTime?       @map("finished_at") @db.Timestamp(6)
  durationMs   BigInt?         @map("duration_ms")
  triggerType  String?         @map("trigger_type") @db.VarChar(50)
  input        Json?
  output       Json?
  errorMessage String?         @map("error_message")
  steps        ExecutionStep[]
  workflow     Workflow        @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([startedAt(sort: Desc)], map: "idx_execution_started")
  @@index([status], map: "idx_execution_status")
  @@index([workflowId], map: "idx_execution_workflow")
  @@map("workflow_executions")
}

model ExecutionStep {
  id           String            @id @db.Uuid
  executionId  String            @map("execution_id") @db.Uuid
  nodeId       String            @map("node_id") @db.Uuid
  parentStepId String?           @map("parent_step_id") @db.Uuid
  status       String            @default("pending") @db.VarChar(30)
  attempt      Int               @default(1)
  startedAt    DateTime?         @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  durationMs   BigInt?           @map("duration_ms")
  input        Json              @default("{}")
  output       Json              @default("{}")
  errorCode    String?           @map("error_code") @db.VarChar(100)
  errorMessage String?           @map("error_message")
  metadata     Json              @default("{}")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node         WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentStep   ExecutionStep?    @relation("StepHierarchy", fields: [parentStepId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childSteps   ExecutionStep[]   @relation("StepHierarchy")

  @@index([executionId], map: "idx_execution_steps_execution")
  @@map("execution_steps")
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}
