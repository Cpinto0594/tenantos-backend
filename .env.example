# =============================================================================
# TenantOS backend — environment reference
# =============================================================================
# Copy to `.env` and fill in. Every variable below is parsed and validated by
# src/infrastructure/config/env.schema.ts at boot; the process exits non-zero
# with a field-by-field report if anything is missing or malformed.
#
# Variables without a default are REQUIRED.
# See docs/ENVIRONMENT.md for the full reference table.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development                  # development | test | production
APP_NAME=tenantos-backend
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
SHUTDOWN_TIMEOUT_MS=10000             # grace period for in-flight requests on SIGTERM

# --- Database ----------------------------------------------------------------
# REQUIRED. Pool size is encoded in the URL for Prisma (connection_limit).
DATABASE_NAME=tenantos
DATABASE_USER=tenantos
DATABASE_PASSWORD=tenantos
DATABASE_PORT=54322
DATABASE_URL=postgresql://$DATABASE_USER:$DATABASE_PASSWORD@localhost:$DATABASE_PORT/$DATABASE_NAME?schema=public
PRISMA_DATABASE_URL=postgresql://tenantos:tenantos@localhost:54322/tenantos?schema=public
DATABASE_POOL_SIZE=10                 # appended as connection_limit if URL omits it
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_STATEMENT_TIMEOUT_MS=15000   # server-side kill switch for runaway queries
DATABASE_LOG_QUERIES=false            # true emits every SQL statement at debug level

# --- Redis -------------------------------------------------------------------
# REQUIRED. Used for cache, token denylist, throttling and the WS pub/sub adapter.
REDIS_URL=redis://localhost:63792
REDIS_KEY_PREFIX=tenantos
REDIS_TLS=false
CACHE_DEFAULT_TTL_S=60

# --- Auth / JWT --------------------------------------------------------------
# REQUIRED. Minimum 32 chars. Generate with: openssl rand -base64 48
# Access and refresh secrets MUST differ — see docs/AUTH.md.
JWT_ACCESS_SECRET=change-me-development-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-development-refresh-secret-min-32-chars
JWT_ACCESS_TTL_S=900                  # 15 minutes
JWT_REFRESH_TTL_S=2592000             # 30 days
JWT_ISSUER=tenantos
JWT_AUDIENCE=tenantos-api

# Password hashing. argon2 (default, recommended) | bcrypt.
# bcrypt exists for compatibility with hashes written by another system; the two
# are NOT interoperable — switching strands every existing hash. See docs/AUTH.md.
PASSWORD_HASHER_ALGORITHM=argon2

# Argon2id tuning. Defaults follow OWASP: 19 MiB, t=2, p=1.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# bcrypt work factor, 10–15. Only read when PASSWORD_HASHER_ALGORITHM=bcrypt.
BCRYPT_COST_ROUNDS=12

# --- Cookies -----------------------------------------------------------------
AUTH_COOKIE_ENABLED=true              # false => tokens are returned in the JSON body only
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false              # MUST be true in production (forced by schema)
AUTH_COOKIE_SAME_SITE=lax             # lax | strict | none

# --- HTTP security -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173   # comma separated, or * (dev only)
CORS_CREDENTIALS=true
TRUST_PROXY=1                         # hops of reverse proxy to trust for client IP

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_S=60
THROTTLE_LIMIT=120                    # global: requests per TTL per client
AUTH_THROTTLE_LIMIT=10                # tighter budget for /auth/* endpoints

# --- Observability -----------------------------------------------------------
LOG_LEVEL=debug                       # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=true                       # false in production => newline-delimited JSON
METRICS_ENABLED=true
METRICS_PATH=/metrics
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- WebSockets --------------------------------------------------------------
WS_ENABLED=true
WS_PATH=/ws
WS_CORS_ORIGINS=http://localhost:5173
