# Test environment. Committed — CI reads this verbatim.
# Points at the `tenantos_test` database so a test run can never truncate dev data.
NODE_ENV=test
APP_NAME=tenantos-backend-test
APP_PORT=3001
APP_HOST=127.0.0.1
API_PREFIX=api
API_VERSION=1
SHUTDOWN_TIMEOUT_MS=1000

DATABASE_URL=postgresql://tenantos:tenantos@localhost:54322/tenantos_test?schema=public
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOG_QUERIES=false

REDIS_URL=redis://localhost:63792/1
REDIS_KEY_PREFIX=tenantos:test
REDIS_TLS=false
CACHE_DEFAULT_TTL_S=5

JWT_ACCESS_SECRET=test-only-access-secret-not-a-real-secret-32chars
JWT_REFRESH_SECRET=test-only-refresh-secret-not-a-real-secret-32chars
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=3600
JWT_ISSUER=tenantos
JWT_AUDIENCE=tenantos-api

# Cheapest legal Argon2 parameters: hashing dominates test runtime otherwise.
ARGON2_MEMORY_COST_KIB=8192
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
TRUST_PROXY=1

# Effectively disabled so tests don't flake on the throttler.
THROTTLE_TTL_S=60
THROTTLE_LIMIT=100000
AUTH_THROTTLE_LIMIT=100000

LOG_LEVEL=silent
LOG_PRETTY=false
METRICS_ENABLED=false
METRICS_PATH=/metrics
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

WS_ENABLED=true
WS_PATH=/ws
WS_CORS_ORIGINS=http://localhost:3000
