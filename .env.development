# Local development defaults. Committed on purpose — contains no real secrets.
# Anything you need to override locally goes in `.env.development.local` (git-ignored).
NODE_ENV=development
APP_NAME=tenantos-backend
APP_PORT=8090
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
SHUTDOWN_TIMEOUT_MS=5000

DATABASE_NAME=tenantos
DATABASE_USER=tenantos
DATABASE_PASSWORD=tenantos
DATABASE_PORT=54322
DATABASE_URL=postgresql://$DATABASE_USER:$DATABASE_PASSWORD@localhost:$DATABASE_PORT/$DATABASE_NAME?schema=public
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOG_QUERIES=false

REDIS_URL=redis://localhost:63792
REDIS_KEY_PREFIX=tenantos:dev
REDIS_TLS=false
CACHE_DEFAULT_TTL_S=60

JWT_ACCESS_SECRET=dev-only-access-secret-do-not-use-anywhere-else-32
JWT_REFRESH_SECRET=dev-only-refresh-secret-do-not-use-anywhere-else-32
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000
JWT_ISSUER=tenantos
JWT_AUDIENCE=tenantos-api

ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
TRUST_PROXY=1

THROTTLE_TTL_S=60
THROTTLE_LIMIT=1000
AUTH_THROTTLE_LIMIT=50

LOG_LEVEL=debug
LOG_PRETTY=true
METRICS_ENABLED=true
METRICS_PATH=/metrics
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

WS_ENABLED=true
WS_PATH=/ws
WS_CORS_ORIGINS=http://localhost:5173
